{
  "name": "student-ts",
  "version": "1.0.0",
  "description": "API CRUD pour gestion des étudiants en TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec ts-node src/server.ts",
    "seed": "npx ts-node scripts/seed.ts",
    "clean": "rm -rf dist"
  },
  "nodemonConfig": {
    "watch": ["src"],
    "ext": "ts",
    "ignore": ["src/**/*.spec.ts", "node_modules"],
    "exec": "ts-node src/server.ts",
    "env": {
      "NODE_ENV": "development"
    }
  },
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.0.0",
    "dotenv": "^16.0.3",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/mongoose": "^5.11.97",
    "@types/node": "^18.15.0",
    "@types/cors": "^2.8.13",
    "typescript": "^5.0.2",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.1"
  }
}